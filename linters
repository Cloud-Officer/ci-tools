#!/usr/bin/env bash
set -euo pipefail

# This script uses bash 4+ features (mapfile). `#!/usr/bin/env bash` resolves to
# the first bash on PATH, which on macOS is often Apple's bash 3.2 -- /bin comes
# before /opt/homebrew/bin whenever /usr/libexec/path_helper runs after the
# shell profile (login sh/bash, /etc/profile, some GUI-launched tools). Re-exec
# under a newer bash rather than failing with an obscure syntax error.
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash /usr/bin/bash; do
    # shellcheck disable=SC2016
    if [ -x "${candidate}" ] && [ "$("${candidate}" -c 'echo ${BASH_VERSINFO[0]}')" -ge 4 ]; then
      # ${@+"${@}"} rather than "${@}": bash 3.2 treats the braced form as an
      # unset variable under `set -u` when there are no positional parameters.
      exec "${candidate}" "${0}" ${@+"${@}"}
    fi
  done

  echo "linters requires bash 4 or newer (running ${BASH_VERSION}); install it with 'brew install bash'" >&2
  exit 1
fi

FAILED=0

# Returns 0 (success) on macOS so callers can use `if is_darwin; then brew ... else <other> ; fi`.
is_darwin() {
  [ "$(uname -s)" == "Darwin" ]
}

# Emits "sudo" or "" depending on whether the named command's path is user-writable.
# Usage: $(sudo_for_user_command npm) npm install -g foo
sudo_for_user_command() {
  local resolved
  resolved="$(command -v "${1}" 2>/dev/null)"

  if [ -n "${resolved}" ] && [ -w "$(dirname "${resolved}")" ]; then
    echo ""
  else
    echo "sudo"
  fi
}

# Emits the release-asset architecture for the current machine, using the same
# uname mapping and unsupported-arch failure as sync-jira-release. Downloads of
# release binaries must not assume x86_64 -- the project image and CI both run
# on arm64 as well.
release_arch() {
  case "$(uname -m)" in
    arm64 | aarch64) echo "arm64" ;;
    x86_64 | amd64) echo "x86_64" ;;
    *)
      echo "Error: Unsupported architecture: $(uname -m)" >&2
      return 1
      ;;
  esac
}

# Installs a Python CLI tool in its own isolated environment via pipx, on Linux.
# pipx is used instead of a bare `pip3 install` because Debian 12+/Ubuntu 23.04+
# mark the system Python externally managed (PEP 668), so pip3 refuses to install
# into it. pipx is bootstrapped through apt when absent (mirroring how the npm
# branch installs npm), and its bin dir is added to PATH (like the go branches).
# Usage: pipx_install cfn-lint
pipx_install() {
  if ! command -v pipx &>/dev/null; then
    sudo apt-get --yes install --no-install-recommends pipx
  fi

  pipx install "${1}"
  export PATH="${PATH}:${HOME}/.local/bin"
}

# Installs a tool that ships in both Homebrew and apt. The apt package name
# defaults to the command name and is overridden with $2 where they differ
# (bandit ships as python3-bandit).
# Usage: brew_or_apt_install yamllint  /  brew_or_apt_install bandit python3-bandit
brew_or_apt_install() {
  if is_darwin; then
    brew install "${1}"
  else
    sudo apt-get --yes install --no-install-recommends "${2:-${1}}"
  fi
}

# Adds the flake8-docstrings plugin CI installs next to flake8, so the D rules
# run locally too. On macOS it goes into the Python environment the flake8
# script runs under (the Homebrew formula's own venv); on Linux it is the apt
# package that sits next to python3-flake8.
install_flake8_docstrings() {
  if is_darwin; then
    local interpreter
    read -r -a interpreter <<< "$(head -n 1 "$(command -v flake8)" | sed 's/^#![[:space:]]*//')"
    "${interpreter[@]}" -m pip install --quiet flake8-docstrings
  else
    sudo apt-get --yes install --no-install-recommends python3-flake8-docstrings
  fi
}

# Installs a Go-based tool: Homebrew on macOS, `go install` on Linux, where the
# module bin dir also has to join PATH for the very next command to find it.
# $3 is an optional Homebrew tap for formulae outside homebrew-core (protolint).
# Usage: brew_or_go_install actionlint github.com/rhysd/actionlint/cmd/actionlint@latest
brew_or_go_install() {
  if is_darwin; then
    if [ -n "${3:-}" ]; then
      brew tap "${3}"
    fi

    brew install "${1}"
  else
    go install "${2}"
    export PATH="${PATH}:${HOME}/go/bin"
  fi
}

# Installs an npm-distributed tool globally, bootstrapping npm itself when it is
# missing (apt on Linux, Homebrew on macOS) rather than silently skipping the
# install. sudo_for_user_command decides whether the global prefix needs root.
# Usage: npm_install markdownlint-cli2
npm_install() {
  if ! command -v npm &>/dev/null; then
    if is_darwin; then
      brew install node
    else
      sudo apt-get --yes install --no-install-recommends npm
    fi
  fi

  # shellcheck disable=SC2046
  $(sudo_for_user_command npm) npm install -g "${1}"
}

# Mirrors the ghb:excluded-dirs list in trivy.yaml/.semgrepignore; extra find predicates may follow the -name pattern.
find_lintable() {
  find . -name "${1}" ${2+"${@:2}"} \
    -not -path "*/.build/*" \
    -not -path "*/.bundle/*" \
    -not -path "*/.claude/worktrees/*" \
    -not -path "*/.git/*" \
    -not -path "*/.gradle/*" \
    -not -path "*/.hg/*" \
    -not -path "*/.m2/*" \
    -not -path "*/.npm/*" \
    -not -path "*/.pnpm/*" \
    -not -path "*/.pytest_cache/*" \
    -not -path "*/.svn/*" \
    -not -path "*/.venv/*" \
    -not -path "*/.yarn/*" \
    -not -path "*/__pycache__/*" \
    -not -path "*/build/*" \
    -not -path "*/Carthage/*" \
    -not -path "*/coverage/*" \
    -not -path "*/DerivedData/*" \
    -not -path "*/dist/*" \
    -not -path "*/env/*" \
    -not -path "*/Libraries/*" \
    -not -path "*/node_modules/*" \
    -not -path "*/Pods/*" \
    -not -path "*/target/*" \
    -not -path "*/vendor/*" \
    -not -path "*/venv/*"
}

# Discovers the shell scripts to lint: *.sh by name, plus extensionless executables
# whose shebang names a shell. The four tools this repo ships -- linters, ssm-jump,
# sync-jira-release, generate-codeowners -- install onto PATH without a suffix, so a
# name-only glob never saw them. shellcheck itself does not care about the
# extension; it dispatches on the shebang.
#
# Detection is by shebang rather than by the executable bit alone: a non-shell
# script fails with SC1071 rather than being skipped, and this repo's Ruby CLIs
# are executable too. Bats suites are excluded the same way -- their shebang is
# not a shell, and their @test syntax would not parse.
find_shell_scripts() {
  find_lintable "*.sh"

  while IFS= read -r candidate; do
    if head -n 1 "${candidate}" 2>/dev/null | grep -qE '^#!.*[/ ](ba|da|k)?sh([[:space:]]|$)'; then
      echo "${candidate}"
    fi
  done < <(find_lintable "*" -type f -perm -u+x ! -name "*.*")
}

# Custom shell-script rules that shellcheck doesn't cover, ported from the
# historical shell_linter.rb. Runs after shellcheck over the same *.sh files:
#   SL0001 - prefer ${var} over $var
#   SL0002 - prefer == over a single = inside [ ... ]
# Single-quoted spans, escaped \$ and comments are ignored; a
# `# shellcheck disable=all` directive skips the rest of that file.
shell_lint_custom() {
  local sh_files=()
  mapfile -t sh_files < <(find_shell_scripts)

  if [ ${#sh_files[@]} -eq 0 ]; then
    return 0
  fi

  # shellcheck disable=SC2016
  awk '
    function report(file, line_num, col, code, line,    pad) {
      pad = sprintf("%*s", col, "")
      print "In " file " line " line_num ":"
      print "    " line
      print "    " pad "^-- " code " (" sev[code] "): " msg[code]
      print "    " hint[code]
      print ""
    }
    BEGIN {
      quote = sprintf("%c", 39)
      sev["SL0001"]  = "warning"
      msg["SL0001"]  = "Use ${var} with braces instead of $var for readability and to avoid ambiguity with adjacent text."
      hint["SL0001"] = "Replace $var with ${var}."
      sev["SL0002"]  = "warning"
      msg["SL0002"]  = "Inside [ ... ], use '\''=='\'' for string equality; a single '\''='\'' looks like assignment."
      hint["SL0002"] = "Replace '\''='\'' with '\''=='\''."
    }
    FNR == 1 { inside_quotes = 0 }
    skip[FILENAME] { next }
    index($0, "# shellcheck disable=all") { skip[FILENAME] = 1; next }
    {
      line = $0
      prev = ""

      for (i = 1; i <= length(line); i++) {
        c = substr(line, i, 1)

        if (!inside_quotes && c == "#" && (prev == "" || prev == " " || prev == "\t")) {
          break
        }

        if (c == quote) {
          inside_quotes = !inside_quotes
        } else if (c == "$" && !inside_quotes && prev != "\\") {
          if (substr(line, i) ~ /^\$[a-zA-Z_][a-zA-Z0-9_]*/) {
            report(FILENAME, FNR, i - 1, "SL0001", line)
            rc = 1
          }
        }

        prev = c
      }

      code = substr(line, 1, i - 1)

      if (index(code, "[") && index(code, "]") && code ~ /\[.* = .*\]/ && code !~ /\[.*==.*\]/) {
        pos = index(code, " = ")
        report(FILENAME, FNR, pos ? pos : 0, "SL0002", line)
        rc = 1
      }
    }
    END { exit rc }
  ' "${sh_files[@]}"
}


brew_or_npm_install() {
  if is_darwin; then
    brew install "${1}"
  else
    npm_install "${1}"
  fi
}

brew_or_pipx_install() {
  if is_darwin; then
    brew install "${1}"
  else
    pipx_install "${1}"
  fi
}

install_hadolint() {
  if is_darwin; then
    brew install hadolint
    return
  fi

  local asset tmp expected actual
  asset="hadolint-linux-$(release_arch)"
  tmp=$(mktemp)
  wget -qO "${tmp}" "https://github.com/hadolint/hadolint/releases/latest/download/${asset}"
  expected=$(wget -qO - https://github.com/hadolint/hadolint/releases/latest/download/checksums.sha256 | awk -v asset="*${asset}" '$2 == asset {print $1}' || true)

  if [ -z "${expected}" ]; then
    echo "Error: no published checksum for ${asset}"
    rm -f "${tmp}"
    exit 1
  fi

  if command -v sha256sum &> /dev/null; then
    actual=$(sha256sum "${tmp}" | awk '{print $1}')
  else
    actual=$(shasum -a 256 "${tmp}" | awk '{print $1}')
  fi

  if [ "${expected}" != "${actual}" ]; then
    echo "Error: Checksum verification failed for hadolint!"
    echo "Expected: ${expected}"
    echo "Actual:   ${actual}"
    rm -f "${tmp}"
    exit 1
  fi

  sudo install -m 0755 "${tmp}" /usr/local/bin/hadolint
  rm -f "${tmp}"
}

# Floating-latest release; PMD's signing key fingerprint is the trust anchor.
install_pmd() {
  if is_darwin; then
    brew install pmd
    return
  fi

  local signing_key="2EFA55D0785C31F956F2F87EA0B5CA1A4E086838"
  local version tmp url
  sudo apt-get --yes install --no-install-recommends gnupg unzip
  version=$(curl -fsS https://api.github.com/repos/pmd/pmd/releases/latest | grep '"tag_name"' | sed -E 's|.*"pmd_releases/([^"]+)".*|\1|' || true)

  if [ -z "${version}" ]; then
    echo "Error: Could not determine latest pmd version"
    exit 1
  fi

  tmp=$(mktemp -d)
  url="https://github.com/pmd/pmd/releases/download/pmd_releases/${version}/pmd-dist-${version}-bin.zip"
  wget -qO "${tmp}/pmd.zip" "${url}"
  wget -qO "${tmp}/pmd.zip.asc" "${url}.asc"
  gpg --batch --keyserver keyserver.ubuntu.com --recv-keys "${signing_key}"

  if ! gpg --batch --verify "${tmp}/pmd.zip.asc" "${tmp}/pmd.zip"; then
    echo "Error: Signature verification failed for pmd ${version}!"
    rm -rf "${tmp}"
    exit 1
  fi

  unzip -qd "${tmp}" "${tmp}/pmd.zip"
  sudo rm -rf "/opt/pmd-bin-${version}"
  sudo mv "${tmp}/pmd-bin-${version}" /opt/
  sudo ln -sf "/opt/pmd-bin-${version}/bin/pmd" /usr/local/bin/pmd
  rm -rf "${tmp}"
}

install_trivy() {
  if is_darwin; then
    brew install trivy
    return
  fi

  sudo apt-get --yes install --no-install-recommends wget apt-transport-https gnupg
  wget -qO - https://get.trivy.dev/deb/public.key | gpg --dearmor | sudo tee /usr/share/keyrings/trivy.gpg > /dev/null
  echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://get.trivy.dev/deb generic main" | sudo tee /etc/apt/sources.list.d/trivy.list > /dev/null
  sudo apt-get update
  sudo apt-get --yes install --no-install-recommends trivy
}

# .eslintrc.json is the legacy config format, which only eslint@8 supports.
install_eslint8() {
  local install=0

  if ! command -v eslint &>/dev/null; then
    echo "Installing eslint@8 because not present"
    install=1
  fi

  if ! eslint --version | grep "^v8\." &>/dev/null; then
    echo "Installing eslint@8 because wrong version"
    install=1
  fi

  if [ "${install}" -eq 1 ]; then
    npm_install eslint@8
  fi
}

install_flake8() {
  if ! command -v flake8 &>/dev/null; then
    brew_or_apt_install flake8
  fi

  if ! flake8 --version | grep -q "flake8-docstrings"; then
    install_flake8_docstrings
  fi
}

install_rubocop() {
  local gems=(rubocop rubocop-capybara rubocop-graphql rubocop-i18n rubocop-minitest rubocop-performance rubocop-rails rubocop-rake rubocop-rspec rubocop-rspec_rails rubocop-thread_safety)

  if rubocop --version &>/dev/null; then
    return
  fi

  if is_darwin; then
    gem install "${gems[@]}"
  else
    $(sudo_for_user_command gem) gem install "${gems[@]}"
  fi
}

install_swiftlint() {
  if is_darwin; then
    brew install swiftlint
  else
    echo "Error: only supported on MacOS!"
    exit 1
  fi
}

trivy_scanners() {
  local scanners="secret" sm_path lock_file
  local submodule_prune=()

  if [ -f .cfnlintrc ] || [ -f .hadolint.yaml ] || \
     find . -maxdepth 3 -name "*.tf" -print -quit 2>/dev/null | grep -q . || \
     find . -maxdepth 3 -name "Dockerfile*" -print -quit 2>/dev/null | grep -q .; then
    scanners="${scanners},misconfig"
  fi

  if [ -f .gitmodules ]; then
    while IFS= read -r sm_path; do
      submodule_prune+=("-path" "./${sm_path}" "-prune" "-o")
    done < <(grep 'path = ' .gitmodules | sed 's/.*path = //')
  fi

  for lock_file in package-lock.json yarn.lock pnpm-lock.yaml go.sum \
                   requirements.txt Pipfile.lock poetry.lock \
                   Gemfile.lock composer.lock \
                   pom.xml build.gradle build.gradle.kts \
                   Cargo.lock Package.resolved; do
    if find . ${submodule_prune[@]+"${submodule_prune[@]}"} -name "${lock_file}" -print -quit 2>/dev/null | grep -q .; then
      scanners="${scanners},vuln"
      break
    fi
  done

  echo "${scanners}"
}

lint_shell_scripts() {
  local rc=0 shell_files=()
  mapfile -t shell_files < <(find_shell_scripts)

  if [ ${#shell_files[@]} -gt 0 ]; then
    shellcheck --external-sources "${shell_files[@]}" || rc=1
  else
    echo "No shell scripts found, skipping"
  fi

  echo "Checking shell scripts (custom rules)..."
  shell_lint_custom || rc=1
  return "${rc}"
}

lint_dockerfiles() {
  local dockerfiles=()
  mapfile -t dockerfiles < <(find_lintable "Dockerfile*")

  if [ ${#dockerfiles[@]} -gt 0 ]; then
    hadolint "${dockerfiles[@]}"
  else
    echo "No Dockerfiles found, skipping"
  fi
}

lint_trivy() {
  local scanners
  scanners=$(trivy_scanners)
  echo "Trivy scanners: ${scanners}"
  trivy fs --scanners "${scanners}" --exit-code 1 .
}

with_trailing_blank_line() {
  local rc=0
  "${@}" || rc=$?
  echo
  return "${rc}"
}

has_workflow_files() {
  local yml_files=(.github/workflows/*.yml) yaml_files=(.github/workflows/*.yaml)
  [[ -e ${yml_files[0]} ]] || [[ -e ${yaml_files[0]} ]]
}

# Usage: lint_with <message> <tool|""> <install cmd...> -- <lint cmd...>; an empty tool always runs the installer.
lint_with() {
  local message="${1}" tool="${2}" install=()
  shift 2

  while [ "${1}" != "--" ]; do
    install+=("${1}")
    shift
  done

  shift
  echo "${message}"

  if [ -z "${tool}" ] || ! command -v "${tool}" &>/dev/null; then
    "${install[@]}"
  fi

  "${@}" || FAILED=1
}

# Usage: run_linter <config file> <lint_with args...>
run_linter() {
  if [ -f "${1}" ]; then
    lint_with "${@:2}"
  fi
}

if has_workflow_files; then
  lint_with "Checking GitHub Actions workflow files..." actionlint brew_or_go_install actionlint github.com/rhysd/actionlint/cmd/actionlint@latest -- actionlint
fi

run_linter .markdownlint-cli2.yaml "Checking Markdown..." markdownlint-cli2 brew_or_npm_install markdownlint-cli2 -- markdownlint-cli2 "**/*.md"
run_linter .yamllint.yml "Checking YAML..." yamllint brew_or_apt_install yamllint -- yamllint --strict .
run_linter .shellcheckrc "Checking shell scripts..." shellcheck brew_or_apt_install shellcheck -- lint_shell_scripts
run_linter .hadolint.yaml "Checking Dockerfiles..." hadolint install_hadolint -- lint_dockerfiles
run_linter .cfnlintrc "Checking CloudFormation templates..." cfn-lint brew_or_pipx_install cfn-lint -- cfn-lint --non-zero-exit-code error
run_linter .golangci.yml "Checking Go..." golangci-lint brew_or_go_install golangci-lint github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest -- golangci-lint run
run_linter .pmd.xml "Checking Java/JS/SQL with pmd..." pmd install_pmd -- with_trailing_blank_line pmd check --dir . --format textcolor --rulesets ".pmd.xml"
run_linter .eslintrc.json "Checking JS with eslint..." "" install_eslint8 -- eslint .
run_linter .editorconfig "Checking Kotlin with ktlint..." ktlint brew_or_apt_install ktlint -- ktlint
run_linter .bandit "Checking Python with bandit..." bandit brew_or_apt_install bandit python3-bandit -- with_trailing_blank_line bandit -ll --ini .bandit --silent .
run_linter .flake8 "Checking Python with flake8..." "" install_flake8 -- flake8 .
run_linter .protolint.yaml "Checking Protocol Buffer with protolint..." protolint brew_or_go_install protolint github.com/yoheimuta/protolint/cmd/protolint@latest yoheimuta/protolint -- protolint .
run_linter .rubocop.yml "Checking Ruby..." "" install_rubocop -- with_trailing_blank_line rubocop
run_linter .semgrepignore "Checking with semgrep..." semgrep brew_or_pipx_install semgrep -- semgrep scan --config=auto --severity=ERROR --error --quiet .
run_linter .trivyignore "Checking with trivy..." trivy install_trivy -- lint_trivy
run_linter .swiftlint.yml "Checking Swift..." swiftlint install_swiftlint -- swiftlint lint --strict

if [ "${FAILED}" -eq 1 ]; then
  echo "Some checks failed."
  exit 1
fi

echo "All checks passed."
