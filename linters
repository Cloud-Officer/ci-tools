#!/usr/bin/env bash
set -euo pipefail

# This script uses bash 4+ features (mapfile). `#!/usr/bin/env bash` resolves to
# the first bash on PATH, which on macOS is often Apple's bash 3.2 -- /bin comes
# before /opt/homebrew/bin whenever /usr/libexec/path_helper runs after the
# shell profile (login sh/bash, /etc/profile, some GUI-launched tools). Re-exec
# under a newer bash rather than failing with an obscure syntax error.
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash /usr/bin/bash; do
    # shellcheck disable=SC2016
    if [ -x "${candidate}" ] && [ "$("${candidate}" -c 'echo ${BASH_VERSINFO[0]}')" -ge 4 ]; then
      # ${@+"${@}"} rather than "${@}": bash 3.2 treats the braced form as an
      # unset variable under `set -u` when there are no positional parameters.
      exec "${candidate}" "${0}" ${@+"${@}"}
    fi
  done

  echo "linters requires bash 4 or newer (running ${BASH_VERSION}); install it with 'brew install bash'" >&2
  exit 1
fi

FAILED=0

# Returns 0 (success) on macOS so callers can use `if is_darwin; then brew ... else <other> ; fi`.
is_darwin() {
  [ "$(uname -s)" = "Darwin" ]
}

# Emits "sudo" or "" depending on whether the named command's path is user-writable.
# Usage: $(sudo_for_user_command npm) npm install -g foo
sudo_for_user_command() {
  if command -v "${1}" | grep "${HOME}" &>/dev/null; then
    echo ""
  else
    echo "sudo"
  fi
}

# Emits the release-asset architecture for the current machine, using the same
# uname mapping and unsupported-arch failure as sync-jira-release. Downloads of
# release binaries must not assume x86_64 -- the project image and CI both run
# on arm64 as well.
release_arch() {
  case "$(uname -m)" in
    arm64 | aarch64) echo "arm64" ;;
    x86_64 | amd64) echo "x86_64" ;;
    *)
      echo "Error: Unsupported architecture: $(uname -m)" >&2
      return 1
      ;;
  esac
}

# Installs a Python CLI tool in its own isolated environment via pipx, on Linux.
# pipx is used instead of a bare `pip3 install` because Debian 12+/Ubuntu 23.04+
# mark the system Python externally managed (PEP 668), so pip3 refuses to install
# into it. pipx is bootstrapped through apt when absent (mirroring how the npm
# branch installs npm), and its bin dir is added to PATH (like the go branches).
# Usage: pipx_install cfn-lint
pipx_install() {
  if ! command -v pipx &>/dev/null; then
    sudo apt-get --yes install --no-install-recommends pipx
  fi

  pipx install "${1}"
  export PATH="${PATH}:${HOME}/.local/bin"
}

# Common find filter used for files-to-lint discovery. Pass the -name pattern as $1.
find_lintable() {
  find . -name "${1}" \
    -not -path "*/vendor/*" \
    -not -path "*/node_modules/*" \
    -not -path "*/Libraries/*" \
    -not -path "*/Pods/*" \
    -not -path "*/.build/*" \
    -not -path "*/Carthage/*" \
    -not -path "*/DerivedData/*" \
    -not -path "*/venv/*" \
    -not -path "*/.venv/*" \
    -not -path "*/dist/*" \
    -not -path "*/build/*" \
    -not -path "*/target/*"
}

# Custom shell-script rules that shellcheck doesn't cover, ported from the
# historical shell_linter.rb. Runs after shellcheck over the same *.sh files:
#   SL0001 - prefer ${var} over $var
#   SL0002 - prefer == over a single = inside [ ... ]
# Single-quoted spans, escaped \$ and comments are ignored; a
# `# shellcheck disable=all` directive skips the rest of that file.
shell_lint_custom() {
  local sh_files=()
  mapfile -t sh_files < <(find_lintable "*.sh")

  if [ ${#sh_files[@]} -eq 0 ]; then
    return 0
  fi

  # shellcheck disable=SC2016
  awk '
    function report(file, line_num, col, code, line,    pad) {
      pad = sprintf("%*s", col, "")
      print "In " file " line " line_num ":"
      print "    " line
      print "    " pad "^-- " code " (" sev[code] "): " msg[code]
      print "    " hint[code]
      print ""
    }
    BEGIN {
      quote = sprintf("%c", 39)
      sev["SL0001"]  = "warning"
      msg["SL0001"]  = "Use ${var} with braces instead of $var for readability and to avoid ambiguity with adjacent text."
      hint["SL0001"] = "Replace $var with ${var}."
      sev["SL0002"]  = "warning"
      msg["SL0002"]  = "Inside [ ... ], use '\''=='\'' for string equality; a single '\''='\'' looks like assignment."
      hint["SL0002"] = "Replace '\''='\'' with '\''=='\''."
    }
    FNR == 1 { inside_quotes = 0 }
    skip[FILENAME] { next }
    index($0, "# shellcheck disable=all") { skip[FILENAME] = 1; next }
    {
      line = $0
      prev = ""

      for (i = 1; i <= length(line); i++) {
        c = substr(line, i, 1)

        if (!inside_quotes && c == "#" && (prev == "" || prev == " " || prev == "\t")) {
          break
        }

        if (c == quote) {
          inside_quotes = !inside_quotes
        } else if (c == "$" && !inside_quotes && prev != "\\") {
          if (substr(line, i) ~ /^\$[a-zA-Z_][a-zA-Z0-9_]*/) {
            report(FILENAME, FNR, i - 1, "SL0001", line)
            rc = 1
          }
        }

        prev = c
      }

      if (index(line, "[") && index(line, "]") && line ~ /\[.* = .*\]/ && line !~ /\[.*==.*\]/) {
        pos = index(line, " = ")
        report(FILENAME, FNR, pos ? pos : 0, "SL0002", line)
        rc = 1
      }
    }
    END { exit rc }
  ' "${sh_files[@]}"
}

yml_files=(.github/workflows/*.yml)
yaml_files=(.github/workflows/*.yaml)

if [[ -e ${yml_files[0]} ]] || [[ -e ${yaml_files[0]} ]]; then
  echo "Checking GitHub Actions workflow files..."

  if ! command -v actionlint &>/dev/null; then
    if is_darwin; then
      brew install actionlint
    else
      go install github.com/rhysd/actionlint/cmd/actionlint@latest
      export PATH="${PATH}:${HOME}/go/bin"
    fi
  fi

  actionlint || FAILED=1
fi

if [ -f .markdownlint-cli2.yaml ]; then
  echo "Checking Markdown..."

  if ! command -v markdownlint-cli2 &>/dev/null; then
    if is_darwin; then
      brew install markdownlint-cli2
    elif command -v npm &>/dev/null; then
      $(sudo_for_user_command npm) npm install -g markdownlint-cli2
    fi
  fi

  markdownlint-cli2 "**/*.md" || FAILED=1
fi

if [ -f .yamllint.yml ]; then
  echo "Checking YAML..."

  if ! command -v yamllint &>/dev/null; then
    if is_darwin; then
      brew install yamllint
    else
      sudo apt-get --yes install --no-install-recommends yamllint
    fi
  fi

  yamllint --strict . || FAILED=1
fi

if [ -f .shellcheckrc ]; then
  echo "Checking shell scripts..."

  if ! command -v shellcheck &>/dev/null; then
    if is_darwin; then
      brew install shellcheck
    else
      sudo apt-get --yes install --no-install-recommends shellcheck
    fi
  fi

  # Feed the file list through an array: unquoted $(find_lintable ...) word-splits,
  # and when nothing matches it expands to no operands at all, which exits
  # non-zero on a usage dump and fails the build for a tree with no shell files.
  mapfile -t SHELL_FILES < <(find_lintable "*.sh")

  if [ ${#SHELL_FILES[@]} -gt 0 ]; then
    shellcheck --external-sources "${SHELL_FILES[@]}" || FAILED=1
  else
    echo "No shell scripts found, skipping"
  fi

  echo "Checking shell scripts (custom rules)..."
  shell_lint_custom || FAILED=1
fi

if [ -f .hadolint.yaml ]; then
  echo "Checking Dockerfiles..."

  if ! command -v hadolint &>/dev/null; then
    if is_darwin; then
      brew install hadolint
    else
      # Download to a temp file the current user can always write, verify it, then
      # elevate only for the move into /usr/local/bin -- writing there directly
      # fails for every non-root user (the project image runs as `citools`), and
      # the other Linux branches elevate the same way (sudo apt-get, sudo sh -s).
      # Asset names are lowercase and arch-suffixed (hadolint-linux-x86_64 /
      # hadolint-linux-arm64), and the per-asset .sha256 files no longer exist --
      # every hash now lives in one checksums.sha256, keyed by asset name.
      HADOLINT_ASSET="hadolint-linux-$(release_arch)"
      HADOLINT_TMP=$(mktemp)
      wget -qO "${HADOLINT_TMP}" "https://github.com/hadolint/hadolint/releases/latest/download/${HADOLINT_ASSET}"
      EXPECTED_CHECKSUM=$(wget -qO - https://github.com/hadolint/hadolint/releases/latest/download/checksums.sha256 | awk -v asset="*${HADOLINT_ASSET}" '$2 == asset {print $1}')

      if [ -z "${EXPECTED_CHECKSUM}" ]; then
        echo "Error: no published checksum for ${HADOLINT_ASSET}"
        rm -f "${HADOLINT_TMP}"
        exit 1
      fi

      if command -v sha256sum &> /dev/null; then
        ACTUAL_CHECKSUM=$(sha256sum "${HADOLINT_TMP}" | awk '{print $1}')
      else
        ACTUAL_CHECKSUM=$(shasum -a 256 "${HADOLINT_TMP}" | awk '{print $1}')
      fi

      if [ "${EXPECTED_CHECKSUM}" != "${ACTUAL_CHECKSUM}" ]; then
        echo "Error: Checksum verification failed for hadolint!"
        echo "Expected: ${EXPECTED_CHECKSUM}"
        echo "Actual:   ${ACTUAL_CHECKSUM}"
        rm -f "${HADOLINT_TMP}"
        exit 1
      fi

      sudo install -m 0755 "${HADOLINT_TMP}" /usr/local/bin/hadolint
      rm -f "${HADOLINT_TMP}"
    fi
  fi

  # Same zero-match guard as shellcheck above. The pattern is Dockerfile* -- not
  # the exact name -- to match the scanner-selection test further down, so a repo
  # holding only Dockerfile.ci is linted rather than failing on no operands.
  mapfile -t DOCKERFILES < <(find_lintable "Dockerfile*")

  if [ ${#DOCKERFILES[@]} -gt 0 ]; then
    hadolint "${DOCKERFILES[@]}" || FAILED=1
  else
    echo "No Dockerfiles found, skipping"
  fi
fi

if [ -f .cfnlintrc ]; then
  echo "Checking CloudFormation templates..."

  if ! command -v cfn-lint &>/dev/null; then
    if is_darwin; then
      brew install cfn-lint
    else
      pipx_install cfn-lint
    fi
  fi

  cfn-lint --non-zero-exit-code error || FAILED=1
fi

if [ -f .golangci.yml ]; then
  echo "Checking Go..."

  if ! command -v golangci-lint &>/dev/null; then
    if is_darwin; then
      brew install golangci-lint
    else
      go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest
      export PATH="${PATH}:${HOME}/go/bin"
    fi
  fi

  golangci-lint run || FAILED=1
fi

if [ -f .pmd.xml ]; then
  echo "Checking Java/JS/SQL with pmd..."

  if ! command -v pmd &>/dev/null; then
    if is_darwin; then
      brew install pmd
    else
      # pmd is not packaged for apt, so install the official distribution zip and
      # verify its detached GPG signature against PMD's published release key.
      # The version stays floating-latest (discovered at run time, like the jira
      # CLI); the key fingerprint is the trust anchor, not a version pin.
      PMD_SIGNING_KEY="2EFA55D0785C31F956F2F87EA0B5CA1A4E086838"
      sudo apt-get --yes install --no-install-recommends gnupg unzip
      PMD_VERSION=$(curl -s https://api.github.com/repos/pmd/pmd/releases/latest | grep '"tag_name"' | sed -E 's|.*"pmd_releases/([^"]+)".*|\1|')

      if [ -z "${PMD_VERSION}" ]; then
        echo "Error: Could not determine latest pmd version"
        exit 1
      fi

      PMD_TMP=$(mktemp -d)
      PMD_URL="https://github.com/pmd/pmd/releases/download/pmd_releases/${PMD_VERSION}/pmd-dist-${PMD_VERSION}-bin.zip"
      wget -qO "${PMD_TMP}/pmd.zip" "${PMD_URL}"
      wget -qO "${PMD_TMP}/pmd.zip.asc" "${PMD_URL}.asc"
      gpg --batch --keyserver keyserver.ubuntu.com --recv-keys "${PMD_SIGNING_KEY}"

      if ! gpg --batch --verify "${PMD_TMP}/pmd.zip.asc" "${PMD_TMP}/pmd.zip"; then
        echo "Error: Signature verification failed for pmd ${PMD_VERSION}!"
        rm -rf "${PMD_TMP}"
        exit 1
      fi

      unzip -qd "${PMD_TMP}" "${PMD_TMP}/pmd.zip"
      sudo rm -rf "/opt/pmd-bin-${PMD_VERSION}"
      sudo mv "${PMD_TMP}/pmd-bin-${PMD_VERSION}" /opt/
      sudo ln -sf "/opt/pmd-bin-${PMD_VERSION}/bin/pmd" /usr/local/bin/pmd
      rm -rf "${PMD_TMP}"
    fi
  fi

  pmd check --dir . --format textcolor --rulesets ".pmd.xml" || FAILED=1
  echo
fi

# .eslintrc.json is the legacy config format, which requires eslint@8.
# eslint v9+ only supports the flat config format (eslint.config.js/mjs).
if [ -f .eslintrc.json ]; then
  echo "Checking JS with eslint..."

  INSTALL_ESLINT=0

  if ! command -v eslint &>/dev/null; then
    echo "Installing eslint@8 because not present"
    INSTALL_ESLINT=1
  fi

  if ! eslint --version | grep "^v8\." &>/dev/null; then
    echo "Installing eslint@8 because wrong version"
    INSTALL_ESLINT=1
  fi

  if [ ${INSTALL_ESLINT} -eq 1 ]; then
    if is_darwin; then
      npm install -g eslint@8
    else
      if ! command -v npm &>/dev/null; then
        sudo apt-get --yes install --no-install-recommends npm
      fi

      $(sudo_for_user_command npm) npm install -g eslint@8
    fi
  fi

  eslint . || FAILED=1
fi

if [ -f .editorconfig ]; then
  echo "Checking Kotlin with ktlint..."

  if ! command -v ktlint &>/dev/null; then
    if is_darwin; then
      brew install ktlint
    else
      sudo apt-get --yes install --no-install-recommends ktlint
    fi
  fi

  ktlint || FAILED=1
fi

if [ -f .bandit ]; then
  echo "Checking Python with bandit..."

  if ! command -v bandit &>/dev/null; then
    if is_darwin; then
      brew install bandit
    else
      sudo apt-get --yes install --no-install-recommends python3-bandit
    fi
  fi

  bandit -ll --ini .bandit --silent . || FAILED=1
  echo
fi

if [ -f .flake8 ]; then
  echo "Checking Python with flake8..."

  if ! command -v flake8 &>/dev/null; then
    if is_darwin; then
      brew install flake8
    else
      sudo apt-get --yes install --no-install-recommends flake8
    fi
  fi

  flake8 . || FAILED=1
fi

if [ -f .protolint.yaml ]; then
  echo "Checking Protocol Buffer with protolint..."

  if ! command -v protolint &>/dev/null; then
    if is_darwin; then
      brew tap yoheimuta/protolint
      brew install protolint
    else
      go install github.com/yoheimuta/protolint/cmd/protolint@latest
      export PATH="${PATH}:${HOME}/go/bin"
    fi
  fi

  protolint . || FAILED=1
fi

if [ -f .rubocop.yml ]; then
  echo "Checking Ruby..."

  if ! rubocop --version &>/dev/null; then
    if is_darwin; then
      gem install rubocop rubocop-capybara rubocop-graphql rubocop-i18n rubocop-minitest rubocop-performance rubocop-rails rubocop-rake rubocop-rspec rubocop-rspec_rails rubocop-thread_safety
    else
      $(sudo_for_user_command gem) gem install rubocop rubocop-capybara rubocop-graphql rubocop-i18n rubocop-minitest rubocop-performance rubocop-rails rubocop-rake rubocop-rspec rubocop-rspec_rails rubocop-thread_safety
    fi
  fi

  rubocop || FAILED=1
  echo
fi

if [ -f .semgrepignore ]; then
  echo "Checking with semgrep..."

  if ! command -v semgrep &>/dev/null; then
    if is_darwin; then
      brew install semgrep
    else
      pipx_install semgrep
    fi
  fi

  semgrep scan --config=auto --severity=ERROR --error --quiet . || FAILED=1
fi

if [ -f .trivyignore ]; then
  echo "Checking with trivy..."

  if ! command -v trivy &>/dev/null; then
    if is_darwin; then
      brew install trivy
    else
      # Install from Aqua's own signed apt repository rather than piping
      # contrib/install.sh from the mutable main branch into a root shell: apt
      # verifies the GPG signature on every package, and the version stays
      # floating-latest exactly as it was before.
      sudo apt-get --yes install --no-install-recommends wget apt-transport-https gnupg
      wget -qO - https://get.trivy.dev/deb/public.key | gpg --dearmor | sudo tee /usr/share/keyrings/trivy.gpg > /dev/null
      echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://get.trivy.dev/deb generic main" | sudo tee /etc/apt/sources.list.d/trivy.list > /dev/null
      sudo apt-get update
      sudo apt-get --yes install --no-install-recommends trivy
    fi
  fi

  SCANNERS="secret"

  if [ -f .cfnlintrc ] || [ -f .hadolint.yaml ] || \
     find . -maxdepth 3 -name "*.tf" -print -quit 2>/dev/null | grep -q . || \
     find . -maxdepth 3 -name "Dockerfile*" -print -quit 2>/dev/null | grep -q .; then
    SCANNERS="${SCANNERS},misconfig"
  fi

  # Build submodule exclusion paths for find
  SUBMODULE_PRUNE=()
  if [ -f .gitmodules ]; then
    while IFS= read -r sm_path; do
      SUBMODULE_PRUNE+=("-path" "./${sm_path}" "-prune" "-o")
    done < <(grep 'path = ' .gitmodules | sed 's/.*path = //')
  fi

  for lock_file in package-lock.json yarn.lock pnpm-lock.yaml go.sum \
                   requirements.txt Pipfile.lock poetry.lock \
                   Gemfile.lock composer.lock \
                   pom.xml build.gradle build.gradle.kts \
                   Cargo.lock Package.resolved; do
    if find . "${SUBMODULE_PRUNE[@]}" -name "${lock_file}" -print -quit 2>/dev/null | grep -q .; then
      SCANNERS="${SCANNERS},vuln"
      break
    fi
  done

  echo "Trivy scanners: ${SCANNERS}"
  trivy fs --scanners "${SCANNERS}" --exit-code 1 . || FAILED=1
fi

if [ -f .swiftlint.yml ]; then
  echo "Checking Swift..."

  if ! command -v swiftlint &>/dev/null; then
    if is_darwin; then
      brew install swiftlint
    else
      echo "Error: only supported on MacOS!"
      exit 1
    fi
  fi

  swiftlint lint --strict || FAILED=1
fi

if [ ${FAILED} -eq 1 ]; then
  echo "Some checks failed."
  exit 1
fi

echo "All checks passed."
